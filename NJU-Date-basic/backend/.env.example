# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change-me-to-a-random-secret

# Admin
ADMIN_KEY=change-me-to-a-random-admin-key

# Heartbox
HEARTBOX_STUDENT_ID_PEPPER=change-me-to-a-random-pepper

# Email (SMTP) - 开发环境下 OTP 会直接打印到控制台
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=NJU Match <noreply@example.com>

# Email Provider
# smtp | aliyun_api
EMAIL_PROVIDER=smtp

# Aliyun DirectMail API
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_DM_ACCOUNT_NAME=no-reply@example.com
ALIYUN_DM_FROM_ALIAS=NJU Match
ALIYUN_DM_REPLY_TO_ADDRESS=false

# AI - 通义千问 (DashScope OpenAI-compatible API)
DASHSCOPE_API_KEY=your-dashscope-api-key
QWEN_MODEL=qwen-plus

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3001
# Frontend URL used in email CTA links
FRONTEND_PUBLIC_URL=http://localhost:3001
# Multiple frontend origins (comma-separated), overrides FRONTEND_URL when set
# FRONTEND_URLS=http://localhost:3001,https://yourdomain.com

# Security
# When deploying behind reverse proxy (Nginx/Cloudflare), set to true
TRUST_PROXY=false
# Limit for JSON request body size
JSON_BODY_LIMIT=256kb

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nju_date
DB_SSL=false
DB_POOL_MAX=10
