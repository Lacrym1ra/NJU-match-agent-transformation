# Local-only Docker Compose environment. These deterministic values are not
# production secrets. Copy to .env.local-test and run with --env-file.

NODE_ENV=development

POSTGRES_DB=nju_date
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-test-postgres-password
DB_POOL_MAX=5

JWT_SECRET=local-test-jwt-secret-not-for-production
ADMIN_KEY=local-test-admin-key-not-for-production
CONTACT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CONTACT_BLIND_INDEX_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
HEARTBOX_STUDENT_ID_PEPPER=local-test-heartbox-pepper-not-for-production

FRONTEND_URLS=http://localhost:8082,http://127.0.0.1:8082
FRONTEND_PUBLIC_URL=http://localhost:8082
SUPPORT_EMAIL=local-test@example.invalid
MATCH_BIND_PORT=8082

# External delivery and real LLM calls stay disabled in local smoke tests.
EMAIL_PROVIDER=aliyun_api
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_DM_ACCOUNT_NAME=
ALIYUN_DM_FROM_ALIAS=NJU Match Local Test
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
