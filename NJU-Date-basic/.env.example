# ========== Required ==========
JWT_SECRET=change-me-to-a-random-secret
ADMIN_KEY=change-me-to-a-random-admin-key

# Maintenance watchdog alert recipient.
# The watchdog sends alert mail through Aliyun DirectMail API, not through the backend.
MAINTENANCE_ALERT_TO=admin@example.com
BACKEND_WATCHDOG_FAILURE_THRESHOLD=3
SUPPORT_EMAIL=njumatch@163.com

# ========== Database ==========
POSTGRES_DB=nju_date
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ========== Email (阿里云邮件推送 DirectMail API) ==========
ALIYUN_DM_ACCESS_KEY_ID=your-access-key-id
ALIYUN_DM_ACCESS_KEY_SECRET=your-access-key-secret
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_DM_ACCOUNT_NAME=no-reply@yourdomain.com
ALIYUN_DM_FROM_ALIAS=NJU Date

# ========== AI (通义千问 DashScope) ==========
DASHSCOPE_API_KEY=your-dashscope-api-key

# ========== Frontend ==========
# Your domain, used for CORS
FRONTEND_URLS=http://localhost

# Host port (default 80)
PORT=80

# ========== Optional ==========
# Defaults to a JWT_SECRET-derived value. Set only if you intentionally want a
# separate long-term pepper for Heartbox student-id hashes.
# HEARTBOX_STUDENT_ID_PEPPER=change-me-to-a-random-pepper
