# Copy this file to .env only on the deployment host. Never commit real values.

# ========== Required secrets ==========
# Generate independent cryptographically random values for every entry.
JWT_SECRET=replace-with-random-jwt-secret
ADMIN_KEY=replace-with-random-admin-key
CONTACT_ENCRYPTION_KEY=replace-with-random-contact-encryption-key
CONTACT_BLIND_INDEX_KEY=replace-with-random-contact-blind-index-key

# ========== Database ==========
POSTGRES_DB=nju_date
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-database-password
DB_POOL_MAX=5

# ========== Public application settings ==========
# Replace example.com only when the final domain is confirmed.
FRONTEND_URLS=https://example.com,https://www.example.com
FRONTEND_PUBLIC_URL=https://example.com
SUPPORT_EMAIL=support@example.com
PORT=80

# ========== Maintenance ==========
MAINTENANCE_ALERT_TO=admin@example.com
BACKEND_WATCHDOG_FAILURE_THRESHOLD=3

# ========== Email (Aliyun DirectMail API) ==========
ALIYUN_DM_ACCESS_KEY_ID=replace-with-access-key-id
ALIYUN_DM_ACCESS_KEY_SECRET=replace-with-access-key-secret
ALIYUN_DM_REGION=cn-hangzhou
ALIYUN_DM_ACCOUNT_NAME=no-reply@example.com
ALIYUN_DM_FROM_ALIAS=NJU Match

# ========== AI provider (configure in a later provider task) ==========
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
QWEN_MODEL=qwen-plus

# ========== Optional long-term secret ==========
# Set this before first production use if it must be independent from JWT_SECRET.
# Do not rotate it after student-id hashes have been stored.
# HEARTBOX_STUDENT_ID_PEPPER=replace-with-random-long-term-pepper
