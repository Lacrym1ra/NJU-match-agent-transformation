class User {
  +id: UUID
  +nickname: string
  +profileComplete: boolean
  +creditScore: int
  +creditLevel: CreditLevel
  +isProfileComplete()
}

class ForumPost {
  +id: UUID
  +userId: UUID
  +circleId: UUID?
  +title: string
  +content: string
  +type: ForumPostType
  +isAnonymous: boolean
  +visibility: ForumVisibility
  +isPinned: boolean
  +pinnedCommentId: UUID?
  +likeCount: int
  +favoriteCount: int
  +commentCount: int
  +viewCount: int
  +hotScore: double
  +hasPoll: boolean
  +deletedAt: datetime?
  +markDeleted()
  +pin()
  +unpin()
  +pinComment(commentId)
  +unpinComment()
  +attachPoll(options)
}

class ForumComment {
  +id: UUID
  +postId: UUID
  +userId: UUID
  +content: string?
  +commentType: ForumCommentType
  +voiceUrl: string?
  +transcript: string?
  +parentCommentId: UUID?
  +rootCommentId: UUID?
  +likeCount: int
  +deletedAt: datetime?
  +markDeleted()
}

class ForumPollOption {
  +id: UUID
  +postId: UUID
  +optionText: string
  +displayOrder: int
  +voteCount: int
}

class ForumPollVote {
  +id: UUID
  +postId: UUID
  +optionId: UUID
  +userId: UUID
  +createdAt: datetime
  +isSameVoter(postId, userId)
}

class UserFollow {
  +id: UUID
  +followerId: UUID
  +followeeId: UUID
  +createdAt: datetime
}

class UserMessageSetting {
  +userId: UUID
  +allowDirectMessagesFrom: MessagePrivacy
  +updatedAt: datetime
}

class DirectMessageConversation {
  +id: UUID
  +userAId: UUID
  +userBId: UUID
  +lastMessageAt: datetime
  +contains(userId)
}

class DirectMessage {
  +id: UUID
  +conversationId: UUID
  +senderId: UUID
  +receiverId: UUID
  +content: string
  +createdAt: datetime
  +readAt: datetime?
  +markRead()
}

class ForumReport {
  +id: UUID
  +reporterId: UUID
  +reportedUserId: UUID
  +targetType: ForumReportTargetType
  +postId: UUID?
  +commentId: UUID?
  +reason: string
  +detail: string?
  +status: ForumReportStatus
  +adminNote: string?
  +reviewedAt: datetime?
  +approve(penaltyScore)
  +reject(note)
}

class UserReport {
  +id: UUID
  +reporterId: UUID
  +reportedId: UUID
  +reason: string
  +detail: string?
  +status: ReportStatus
  +adminNote: string?
  +markReviewed(status, adminNote)
}

class UserBlock {
  +id: UUID
  +blockerId: UUID
  +blockedId: UUID
  +equalsPair(blockerId, blockedId)
}

class CreditScoreLog {
  +id: UUID
  +userId: UUID
  +delta: int
  +reason: string
  +sourceType: string
  +sourceId: string?
}

class ForumAnnouncement {
  +id: UUID
  +title: string
  +content: string
  +isActive: boolean
  +priority: int
}

class ForumGuestbookMessage {
  +id: UUID
  +userId: UUID
  +content: string
  +status: string
}

class AuditLog {
  +id: int
  +operatorId: UUID?
  +action: string
  +target: string?
  +detail: string?
  +ip: string?
  +result: string
  +isSuccess()
}

class ForumPostType {
  <<enumeration>>
  general
  squad
  help
  trade
  activity
}

class ForumVisibility {
  <<enumeration>>
  public
  private
}

class ForumCommentType {
  <<enumeration>>
  text
  voice
}

class MessagePrivacy {
  <<enumeration>>
  all
  following
  mutual
  none
}

class ForumReportStatus {
  <<enumeration>>
  pending
  approved
  rejected
}

class ForumReportTargetType {
  <<enumeration>>
  post
  comment
}

class ReportStatus {
  <<enumeration>>
  pending
  reviewed
  warn_update
  dismissed
}

class CreditLevel {
  <<enumeration>>
  normal
  limited
  banned
}

