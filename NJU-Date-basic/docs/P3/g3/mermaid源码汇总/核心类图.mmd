}

class IPostRepository {
  <<interface>>
  +findList(filter, page)
  +findById(postId)
  +save(post)
  +softDelete(postId)
  +togglePin(postId, isPinned)
}

class ICommentRepository {
  <<interface>>
  +findByPost(postId)
  +findById(commentId)
  +save(comment)
  +softDelete(commentId)
}

class IForumInteractionRepository {
  <<interface>>
  +likePost(userId, postId)
  +favoritePost(userId, postId)
  +recordView(userId, postId)
  +likeComment(userId, commentId)
  +updateHotScore(postId)
}

class IForumPollRepository {
  <<interface>>
