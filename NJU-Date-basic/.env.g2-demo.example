# Optional overrides for the G2 demo compose file.
# The demo works without copying this file; copy it only when you need custom ports or keys:
#   cp .env.g2-demo.example .env.g2-demo
#   docker compose --env-file .env.g2-demo -f docker-compose.g2-demo.yml up -d --build

G2_DEMO_FRONTEND_PORT=8080
G2_DEMO_POSTGRES_PORT=55432

G2_POSTGRES_DB=nju_date
G2_POSTGRES_USER=postgres
G2_POSTGRES_PASSWORD=postgres

G2_FRONTEND_URLS=http://localhost:8080,http://127.0.0.1:8080
G2_FRONTEND_PUBLIC_URL=http://localhost:8080

G2_JWT_SECRET=nju-date-g2-demo-jwt-secret
G2_ADMIN_KEY=nju-date-admin-test
G2_HEARTBOX_STUDENT_ID_PEPPER=nju-date-g2-demo-student-id-pepper
G2_CONTACT_ENCRYPTION_KEY=nju-date-local-contact-encryption-key
G2_CONTACT_BLIND_INDEX_KEY=nju-date-local-contact-blind-index-key
